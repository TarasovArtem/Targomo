{
  "name": "targomo-1",
  "version": "1.0.0",
  "description": "E2E Tests",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "test:e2e": "cypress run",
    "chrome": "cypress run --spec 'cypress/e2e/**' --headless --browser chrome",
    "firefox": "cypress run --spec 'cypress/e2e/**' --headless --browser firefox",
    "edge": "cypress run --spec 'cypress/e2e/**' --headless --browser edge",
    "report:merge": "mochawesome-merge reports/cypress/*.json > reports/cypress/report.json",
    "ai:collect": "node scripts/ai/collect-context.js",
    "ai:analyze": "node scripts/ai/analyze-failure.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TarasovArtem/Targomo.git"
  },
  "author": "Artem Tarasov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TarasovArtem/Targomo/issues"
  },
  "homepage": "https://github.com/TarasovArtem/Targomo#readme",
  "devDependencies": {
    "cypress": "^15.19.0",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "openai": "^7.4.0"
  }
}
